# Public origin, including scheme and port. Set this behind a reverse proxy.
KIMERU_APP_ORIGIN=http://localhost:3000
# Use true when serving over HTTPS.
KIMERU_SECURE_COOKIES=false
# Defaults to .data outside Docker.
KIMERU_DATA_DIR=.data
# Optional 32-byte hex encryption key. Otherwise generated in the data directory.
# KIMERU_ENCRYPTION_KEY=
